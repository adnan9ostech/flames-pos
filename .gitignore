# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# One-time Supabase -> MySQL import working data (exports, image map, fixtures)
/scripts/migrate-to-mysql/out/

# production
/build

# Menu photos uploaded from the Menu screen (served by /api/uploads). Lives
# beside the checkout on the server, never in it: a git clean must not eat it.
/uploads/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source photography and review pages. The dishes the app serves live in
# public/menu-images/ and ARE tracked — they ship with the code. These are
# working files: originals, review batches, and archives.
/Digital_Menu_Item_Images (webp 800)/
/menu-images/
menu-images-v2/
menu-photo-review.html
menu-photo-review-2.html
menu-photo-review-final.html
*.zip

# Scratch: ad-hoc DB probes and editor backups. q2.mjs-style files connect to
# whatever DB_NAME points at and interpolate ids into SQL — they must never be
# swept in by `git add -A`.
.tmp-*/
*.bak
*.bak[0-9]

# Local QA review list
qa-review.html

# Session-local Claude Code permissions
.claude/settings.local.json

# Marketing image assets — large binaries, kept out of the code repo
social-media/
